{
  "compilerOptions": {
    "target": "ES2022",
    "outDir": "./dist",
    "declaration": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,

    "lib": ["ES2022", "DOM"],
    "types": ["node"],

    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "tests"]
}
