{
  "name": "@hyperttp/protocol-grpc",
  "version": "0.2.3",
  "description": "grpc",
  "keywords": [
    "grpc"
  ],
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-protocol-grpc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "format": "oxfmt src tests",
    "format:check": "oxfmt src tests --check",
    "pub": "d-publish",
    "dist": "d-dist",
    "build": "tsc && esbuild \"dist/**/*.js\" --outdir=dist --allow-overwrite --minify --sourcemap && d-build",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@hyperttp/types": "^0.5.5",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.5.5",
    "typescript": "^7.0.2"
  }
}
